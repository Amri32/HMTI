# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Appwrite setup credentials
scripts/.appwrite-cred.json
scripts/.appwrite-cred.*.json


# log preview lokal & artefak python
dev-preview.log
__pycache__/
*.pyc

# zip sumber foto pengurus (isi sudah diekstrak ke public/pengurus/)
public/PENGURUS HMTI.zip

# artefak deploy fungsi Appwrite (buat ulang lewat perintah di README fungsi)
code.tar.gz
code-appwrite.tar.gz

# artefak kerja lokal (screenshot audit, script cek CDP, brief)
.impeccable/

# tooling agent lokal (skill, state, worktree, lock file skills)
.agents/
.claude/
.kilo/
skills-lock.json
anti-slop/

# catatan kerja agent (opsional: hapus baris di bawah kalau mau di-commit)
AGENTS.md
CLAUDE.md
